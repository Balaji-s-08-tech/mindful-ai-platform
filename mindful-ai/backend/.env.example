# ─── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000

# ─── Database ─────────────────────────────────────────────────────────────────
# Local MongoDB
MONGODB_URI=mongodb://localhost:27017/mindful_ai

# MongoDB Atlas (cloud) — uncomment and replace if using Atlas
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/mindful_ai

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Authentication ───────────────────────────────────────────────────────────
# IMPORTANT: Change this to a long, random string in production!
JWT_SECRET=change_this_to_a_long_random_secret_minimum_32_chars
JWT_EXPIRES_IN=7d

# ─── AI APIs ──────────────────────────────────────────────────────────────────
# Anthropic Claude (primary LLM)
ANTHROPIC_API_KEY=sk-ant-your-key-here
CLAUDE_MODEL=claude-sonnet-4-20250514

# OpenAI Whisper (speech-to-text) — optional, browser STT used as fallback
OPENAI_API_KEY=sk-your-openai-key-here

# ElevenLabs TTS — optional, browser TTS used as fallback
ELEVENLABS_API_KEY=your-elevenlabs-key-here
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL

# ─── Emotion Detection Microservice ──────────────────────────────────────────
EMOTION_SERVICE_URL=http://localhost:8000

# ─── Local Gemma Inference (Ollama) ───────────────────────────────────────────
# Install Ollama: https://ollama.com  →  then run: ollama pull gemma3:4b
GEMMA_SERVICE_URL=http://localhost:11434
GEMMA_MODEL=gemma3:4b
GEMMA_TIMEOUT_MS=30000

# ─── AI Engine Config ─────────────────────────────────────────────────────────
# Primary LLM: "gemma" (local) or "claude" (cloud)
LLM_PRIMARY=gemma
# Stream responses via SSE / Socket.IO
STREAM_ENABLED=true
# Generation parameters
AI_MAX_TOKENS=1024
AI_TEMPERATURE=0.7
