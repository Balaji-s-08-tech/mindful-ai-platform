# =============================================================================
# MindfulAI Django Backend — Environment Variables Example
# Copy this file to .env and fill in real values before running the server.
# Never commit your real .env file to version control.
# =============================================================================


# -----------------------------------------------------------------------------
# Django Core
# -----------------------------------------------------------------------------

# A long random string used for cryptographic signing. Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=your-very-long-random-secret-key-here

# Set to True only during local development. MUST be False in production.
DJANGO_DEBUG=True

# Comma-separated list of hostnames/IPs Django will serve.
# Example: localhost,127.0.0.1,api.yourdomain.com
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# The dotted path to the settings module to use.
# Use 'config.settings.development' locally, 'config.settings.production' in prod.
DJANGO_SETTINGS_MODULE=config.settings.development


# -----------------------------------------------------------------------------
# Database — PostgreSQL
# -----------------------------------------------------------------------------

# Name of the PostgreSQL database.
DB_NAME=mindfulai_db

# PostgreSQL user with full access to DB_NAME.
DB_USER=mindfulai_user

# Password for the PostgreSQL user.
DB_PASSWORD=supersecretpassword

# Hostname of the PostgreSQL server. Use 'db' if running in Docker Compose.
DB_HOST=localhost

# Port PostgreSQL listens on (default: 5432).
DB_PORT=5432


# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------

# Redis connection URL used for caching and as the Celery broker.
# Format: redis://:password@host:port/db_index
REDIS_URL=redis://localhost:6379/0


# -----------------------------------------------------------------------------
# JWT (SimpleJWT)
# -----------------------------------------------------------------------------

# Lifetime of short-lived access tokens, in minutes.
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60

# Lifetime of long-lived refresh tokens, in days.
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7


# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------

# Comma-separated list of origins allowed to make cross-origin requests.
# Example: http://localhost:3000,https://app.yourdomain.com
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000


# -----------------------------------------------------------------------------
# Email
# -----------------------------------------------------------------------------

# Django email backend class. Options:
#   django.core.mail.backends.console.EmailBackend   (dev — prints to stdout)
#   django.core.mail.backends.smtp.EmailBackend      (production SMTP)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# SMTP server hostname (e.g. smtp.gmail.com, smtp.sendgrid.net).
EMAIL_HOST=smtp.gmail.com

# SMTP port. Common values: 587 (TLS), 465 (SSL), 25 (plain).
EMAIL_PORT=587

# SMTP authentication username (usually your email address).
EMAIL_HOST_USER=your-email@gmail.com

# SMTP authentication password or app-specific password.
EMAIL_HOST_PASSWORD=your-email-password

# Whether to use TLS when connecting to the SMTP server.
EMAIL_USE_TLS=True

# The "From" address used in outgoing emails.
DEFAULT_FROM_EMAIL=MindfulAI <noreply@mindfulai.app>


# -----------------------------------------------------------------------------
# AI / LLM Providers
# -----------------------------------------------------------------------------

# Anthropic Claude API key. Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Claude model identifier to use for chat/completions.
# Example: claude-3-5-sonnet-20241022, claude-3-haiku-20240307
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# OpenAI API key (used as a fallback or for embeddings/whisper).
# Get one at https://platform.openai.com
OPENAI_API_KEY=sk-your-openai-key-here

# ElevenLabs API key for text-to-speech synthesis.
# Get one at https://elevenlabs.io
ELEVENLABS_API_KEY=your-elevenlabs-api-key-here

# ElevenLabs voice ID to use for TTS responses.
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Base URL of the self-hosted Gemma/Ollama service.
GEMMA_SERVICE_URL=http://localhost:11434

# Gemma model name as registered in Ollama.
GEMMA_MODEL=gemma2:9b

# Request timeout for the Gemma service, in milliseconds.
GEMMA_TIMEOUT_MS=30000

# Which LLM provider to use as the primary backend.
# Options: claude, openai, gemma
LLM_PRIMARY=claude

# Whether to stream LLM responses chunk-by-chunk (True/False).
STREAM_ENABLED=True

# Maximum number of tokens the LLM is allowed to generate per response.
AI_MAX_TOKENS=2048

# Sampling temperature for LLM responses (0.0 = deterministic, 1.0 = creative).
AI_TEMPERATURE=0.7


# -----------------------------------------------------------------------------
# Internal / External Services
# -----------------------------------------------------------------------------

# Base URL of the emotion analysis microservice.
EMOTION_SERVICE_URL=http://localhost:8001

# Public URL of the React/Next.js frontend application.
FRONTEND_URL=http://localhost:3000


# -----------------------------------------------------------------------------
# Celery (Async Task Queue)
# -----------------------------------------------------------------------------

# Broker URL Celery connects to for receiving tasks.
# Should match REDIS_URL unless you use a separate Redis instance for Celery.
CELERY_BROKER_URL=redis://localhost:6379/1

# Backend where Celery stores task results.
CELERY_RESULT_BACKEND=redis://localhost:6379/2


# -----------------------------------------------------------------------------
# Application Server
# -----------------------------------------------------------------------------

# Port the Uvicorn/Gunicorn server listens on.
PORT=8000
