# ─── Frontend Environment Variables ─────────────────────────────────────────
# These are baked in at build time by Vite

# API base URL (defaults to /api via Vite proxy in development)
VITE_API_URL=/api

# WebSocket URL (auto-detected in dev, set for production)
# VITE_SOCKET_URL=https://your-production-domain.com

# App environment
VITE_APP_ENV=development

# Feature flags
VITE_ENABLE_CAMERA=true
VITE_ENABLE_VOICE=true
VITE_ENABLE_EMOTION_DETECTION=true
